# Server Configuration
PORT=4500
NODE_ENV=production

# Database Connection (MongoDB Atlas connection string)
MONGO_DB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/Cravings?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# Frontend Client URL (Single URL or comma-separated list of allowed origins)
CLIENT_URL=https://cravings-client.vercel.app,http://localhost:5173

# Cloudinary Media Storage (For uploading restaurant & food photos)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Gmail SMTP Service (For sending OTP and transactional emails)
GMAIL_USERNAME=your_email@gmail.com
GMAIL_PASSCODE=your_google_app_password

# Razorpay Payment Gateway (Optional / Payment Processing)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
